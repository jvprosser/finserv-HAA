IMPALA_HOST=
IMPALA_PORT=21050
IMPALA_DATABASE=retirement_distributions
IMPALA_USER=
IMPALA_PASSWORD=
IMPALA_USE_SSL=true
IMPALA_CA_CERT=

# Column on the daily, transaction, and holdings tables that identifies the client.
# Leave empty until the warehouse column name is confirmed. The events query
# stays unwired until this is set. DEMO_MODE does not need it.
CLIENT_ID_COLUMN=

API_KEY=change-me

# Sample data and an in-memory Salesforce stand-in, so the UI works before NiFi.
DEMO_MODE=false

SFDC_LOGIN_URL=https://login.salesforce.com
SFDC_CLIENT_ID=
SFDC_CLIENT_SECRET=
SFDC_OPPORTUNITY_STAGE=Prospecting
SFDC_ACCOUNT_EXTERNAL_ID_FIELD=
SFDC_API_VERSION=59.0
