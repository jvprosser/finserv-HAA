# Impala coordinator hostname. Required unless DEMO_MODE=true.
IMPALA_HOST=
IMPALA_PORT=21050
IMPALA_DATABASE=retirement_distributions
IMPALA_USE_SSL=true
IMPALA_CA_CERT=
# Leave IMPALA_AUTH empty to use LDAP when IMPALA_PASSWORD is set, and the
# Cloudera AI Kerberos ticket (GSSAPI) otherwise.
IMPALA_AUTH=
IMPALA_USER=
IMPALA_PASSWORD=
IMPALA_KERBEROS_SERVICE=impala
# Set these for a Cloudera Data Warehouse Impala virtual warehouse (JDBC port 443, HTTP).
IMPALA_KRB_HOST=
IMPALA_USE_HTTP_TRANSPORT=false
IMPALA_HTTP_PATH=cliservice

# Column on yodlee_transactions and yodlee_holdings that identifies the client.
CLIENT_ID_COLUMN=client_id
# Column on yodlee_held_away_accounts_daily. That table stores P-7015 on account_id.
DAILY_ID_COLUMN=account_id

API_KEY=change-me

# Sample data and an in-memory Salesforce stand-in, so the UI works before NiFi.
DEMO_MODE=false

SFDC_LOGIN_URL=https://your-domain.my.salesforce.com
SFDC_CLIENT_ID=
SFDC_CLIENT_SECRET=
SFDC_OPPORTUNITY_STAGE=Prospecting
SFDC_ACCOUNT_EXTERNAL_ID_FIELD=
SFDC_API_VERSION=59.0
